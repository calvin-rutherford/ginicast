# FRED API Key (Request at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key_here

# BLS API Key (Optional but recommended, request at https://data.bls.gov/registrationEngine/)
BLS_API_KEY=your_bls_api_key_here

# OECD API Key (If required later)
# OECD_API_KEY=your_oecd_api_key_here

# General settings
LOG_LEVEL=INFO
